@using ObjetosIngresos.ViewModel
@model PreRegistroViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = "_Layout";
}

<div class="min-h-full flex items-center justify-center py-6 px-4">
    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100 p-8 sm:p-12">
        <div class="mb-8 text-center">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 mb-4 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Registro</h2>
            <p class="text-slate-500 text-sm mt-2 max-w-md mx-auto">
                Registra tus datos personales para agilizar tu acceso en portería.
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="mb-6 rounded-2xl bg-red-50 border border-red-200 p-4 text-sm text-red-700">
                <div class="font-semibold mb-1 flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Por favor revisa los siguientes campos:
                </div>
                <ul class="list-disc list-inside space-y-1 ml-6">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Registrar" asp-controller="PreRegistro" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="border-b border-slate-100 pb-4">
                <h3 class="text-xs font-bold uppercase tracking-wider text-indigo-600 mb-4">1. Datos Personales</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label asp-for="Documento" class="block text-xs font-semibold text-slate-700 mb-1">Número de Documento *</label>
                        <input asp-for="Documento" required placeholder="Ej. 1065558901"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300" />
                        <span asp-validation-for="Documento" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Nombres" class="block text-xs font-semibold text-slate-700 mb-1">Nombres *</label>
                        <input asp-for="Nombres" required placeholder="Ej. Carlos Alberto"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300" />
                        <span asp-validation-for="Nombres" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Apellidos" class="block text-xs font-semibold text-slate-700 mb-1">Apellidos *</label>
                        <input asp-for="Apellidos" required placeholder="Ej. Pérez Gómez"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300" />
                        <span asp-validation-for="Apellidos" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div class="sm:col-span-2">
                        <label asp-for="Correo" class="block text-xs font-semibold text-slate-700 mb-1">Correo Electrónico *</label>
                        <input asp-for="Correo" type="email" required placeholder="Ej. carlos.perez@correo.com"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-300" />
                        <span asp-validation-for="Correo" class="text-xs text-red-600 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
                <a asp-controller="Auth" asp-action="Login" class="text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors">
                    &larr; Volver al Inicio de Sesión
                </a>
                <button type="submit"
                        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-md hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    Completar Registro
                </button>
            </div>
        </form>
    </div>
</div>