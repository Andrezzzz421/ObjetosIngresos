@using ObjetosIngresos.ViewModel
@model PreRegistroViewModel
@{
    ViewData["Title"] = "Pre-Registro de Usuario";
    Layout = "_Layout";
}

<div class="min-h-full flex items-center justify-center py-8 px-4 sm:px-6">
    <div class="w-full max-w-xl bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100 p-6 sm:p-10 transition-colors">
        
        <!-- Header -->
        <div class="mb-8 text-center">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 mb-4 shadow-sm ring-4 ring-indigo-50/50">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Pre-Registro de Visitante</h2>
            <p class="text-slate-500 text-sm mt-2 max-w-md mx-auto">
                Ingresa tus datos personales para crear tu cuenta en el sistema. Te enviaremos un código de validación a tu correo.
            </p>
        </div>

        <!-- Indicador de Flujo -->
        <div class="mb-8 flex items-center justify-center gap-3">
            <div class="flex items-center gap-2">
                <span class="w-7 h-7 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center shadow-sm">1</span>
                <span class="text-xs font-bold text-indigo-700">Tus Datos</span>
            </div>
            <div class="w-8 h-0.5 bg-slate-200"></div>
            <div class="flex items-center gap-2 opacity-50">
                <span class="w-7 h-7 rounded-full bg-slate-200 text-slate-600 text-xs font-bold flex items-center justify-center">2</span>
                <span class="text-xs font-medium text-slate-500">Validar Código</span>
            </div>
        </div>

        <!-- Alerta informativa Mi Panel -->
        <div class="mb-6 rounded-2xl bg-indigo-50/70 border border-indigo-100 p-4 text-xs text-indigo-900 flex items-start gap-3">
            <svg class="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
                <span class="font-bold">¿Llevas equipos o dispositivos?</span>
                <p class="mt-0.5 text-indigo-800/90 leading-relaxed">
                    Ya no necesitas registrarlos aquí. Una vez verificado tu pre-registro, podrás acceder a <strong class="underline">Mi Panel</strong> para registrar, editar y controlar todos tus equipos de forma ágil y segura.
                </p>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 rounded-2xl bg-amber-50 border border-amber-200 p-4 text-xs text-amber-800 flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>@TempData["Error"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="mb-6 rounded-2xl bg-red-50 border border-red-200 p-4 text-sm text-red-700">
                <div class="font-semibold mb-1 flex items-center gap-2">
                    <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Por favor revisa los siguientes campos:
                </div>
                <ul class="list-disc list-inside space-y-1 ml-6 text-xs">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Registrar" asp-controller="PreRegistro" method="post" id="formPreRegistro" class="space-y-5">
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label asp-for="Documento" class="block text-xs font-semibold text-slate-700 mb-1">
                        Número de Documento de Identidad <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Documento" required type="text" inputmode="numeric" pattern="[0-9]+" placeholder="Ej. 1065558901"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400 font-mono" />
                    <span asp-validation-for="Documento" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Nombres" class="block text-xs font-semibold text-slate-700 mb-1">
                            Nombres <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Nombres" required placeholder="Ej. Carlos Alberto"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                        <span asp-validation-for="Nombres" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="Apellidos" class="block text-xs font-semibold text-slate-700 mb-1">
                            Apellidos <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Apellidos" required placeholder="Ej. Pérez Gómez"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                        <span asp-validation-for="Apellidos" class="text-xs text-red-600 mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Correo" class="block text-xs font-semibold text-slate-700 mb-1">
                        Correo Electrónico <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Correo" type="email" required placeholder="Ej. carlos.perez@correo.com"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all placeholder:text-slate-400" />
                    <span asp-validation-for="Correo" class="text-xs text-red-600 mt-1 block"></span>
                    <p class="text-[11px] text-slate-400 mt-1">A este correo te enviaremos el código de verificación para confirmar tu identidad.</p>
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-100">
                <a asp-controller="Auth" asp-action="Login" class="text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors inline-flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Volver al Inicio de Sesión
                </a>
                <button type="submit" id="btnSubmit"
                        class="w-full sm:w-auto px-7 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-md hover:shadow-indigo-500/20 hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 flex items-center justify-center gap-2">
                    <span id="btnText">Continuar y Enviar Código</span>
                    <svg id="btnSpinner" class="hidden w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('formPreRegistro').addEventListener('submit', function (e) {
        if (!this.checkValidity()) return;
        const btn = document.getElementById('btnSubmit');
        const text = document.getElementById('btnText');
        const spinner = document.getElementById('btnSpinner');
        btn.disabled = true;
        btn.classList.add('opacity-75', 'cursor-not-allowed');
        text.textContent = 'Enviando código...';
        spinner.classList.remove('hidden');
    });
</script>