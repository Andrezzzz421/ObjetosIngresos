@{
    ViewData["Title"] = "Pre-Registro Exitoso";
    Layout = "_Layout";

    var doc = ViewBag.Documento?.ToString() ?? "0000";
    var nombre = ViewBag.NombreCompleto?.ToString() ?? "Visitante";
    var qrData = $"SGI-VISITANTE|DOC:{doc}|NOMBRE:{nombre}";
    var qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=200x200&margin=10&data={Uri.EscapeDataString(qrData)}";
    var codigoTicket = $"PRE-{doc.Substring(Math.Max(0, doc.Length - 4))}-{DateTime.Now:MMdd}";
}

<div class="min-h-full flex items-center justify-center py-8 px-4 sm:px-6">
    <div class="w-full max-w-xl bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100 p-6 sm:p-10 text-center transition-colors print:shadow-none print:border-none print:p-0">
        
        <!-- Header de éxito -->
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-50 text-emerald-500 mb-4 shadow-sm ring-8 ring-emerald-50/50">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">¡Pre-Registro Completado!</h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-1.5 max-w-md mx-auto">
            Tu cuenta y correo electrónico han sido verificados satisfactoriamente.
        </p>

        <!-- Ticket Digital Imprimible -->
        <div id="ticketPase" class="my-6 p-6 bg-slate-50 rounded-3xl border border-slate-200/80 text-left relative overflow-hidden">
            <!-- Banda superior institucional -->
            <div class="flex items-center justify-between pb-4 border-b border-dashed border-slate-300 mb-4">
                <div>
                    <span class="text-[10px] font-extrabold tracking-widest uppercase text-indigo-600">SGI • Control de Acceso</span>
                    <h3 class="text-base font-bold text-slate-900">Credencial de Visitante</h3>
                </div>
                <div class="text-right">
                    <span class="text-[10px] text-slate-400 block uppercase">Comprobante</span>
                    <span class="font-mono text-xs font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-md">@codigoTicket</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-center">
                <!-- Información -->
                <div class="sm:col-span-2 space-y-2.5 text-xs">
                    <div>
                        <span class="text-slate-400 text-[11px] block">Nombre Completo</span>
                        <span class="font-bold text-slate-800 text-sm">@ViewBag.NombreCompleto</span>
                    </div>
                    <div>
                        <span class="text-slate-400 text-[11px] block">Documento de Identidad</span>
                        <span class="font-semibold text-slate-700 font-mono">@ViewBag.Documento</span>
                    </div>
                    <div>
                        <span class="text-slate-400 text-[11px] block">Correo Electrónico Verificado</span>
                        <span class="font-semibold text-slate-700">@ViewBag.Correo</span>
                    </div>
                    <div>
                        <span class="text-slate-400 text-[11px] block">Rol Asignado</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                            Visitante Activo
                        </span>
                    </div>
                    <div class="pt-1 text-[11px] text-slate-400">
                        <span>Fecha de registro: @ViewBag.FechaRegistro</span>
                    </div>
                </div>

                <!-- Código QR Interactivo -->
                <div class="flex flex-col items-center justify-center sm:border-l sm:border-dashed sm:border-slate-300 sm:pl-4">
                    <div class="bg-white p-2 rounded-2xl shadow-sm border border-slate-200">
                        <img src="@qrUrl" alt="QR Verificación" class="w-28 h-28 object-contain rounded-lg" />
                    </div>
                    <span class="text-[10px] text-slate-400 mt-1.5 font-medium">Validación en Portería</span>
                </div>
            </div>
        </div>

        <!-- Indicación clave para registrar equipos en Mi Panel -->
        <div class="p-5 rounded-2xl bg-indigo-50/80 border border-indigo-200 text-left flex items-start gap-3.5 mb-6 print:hidden">
            <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center shrink-0 shadow-sm mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
            <div>
                <p class="font-bold text-xs sm:text-sm text-indigo-950">¿Necesitas ingresar con equipos o pertenencias?</p>
                <p class="mt-1 text-xs text-indigo-900 leading-relaxed">
                    Inicia sesión en la plataforma utilizando tu <strong>número de documento</strong>. Desde <strong>Mi Panel</strong> podrás registrar tus computadores, portátiles o herramientas y gestionar sus autorizaciones de ingreso en cualquier momento.
                </p>
            </div>
        </div>

        <!-- Acciones rápidas (Imprimir, Copiar) -->
        <div class="flex flex-wrap items-center justify-center gap-2 mb-6 print:hidden">
            <button type="button" onclick="window.print()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 shadow-sm transition-all">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Imprimir Comprobante
            </button>
            <button type="button" onclick="copiarCodigo('@codigoTicket')" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 shadow-sm transition-all" id="btnCopiar">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="txtCopiar">Copiar Comprobante</span>
            </button>
        </div>

        <!-- Botones de Navegación -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center print:hidden">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-xs hover:bg-slate-50 transition-colors">
                Realizar otro registro
            </a>
            <a asp-controller="Auth" asp-action="Login" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs shadow-md transition-colors inline-flex items-center justify-center gap-1.5">
                <span>Ir al Inicio de Sesión / Mi Panel</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>
        </div>
    </div>
</div>

<script>
    function copiarCodigo(texto) {
        navigator.clipboard.writeText(texto).then(() => {
            const txt = document.getElementById('txtCopiar');
            if (txt) {
                txt.textContent = '¡Copiado!';
                setTimeout(() => { txt.textContent = 'Copiar Comprobante'; }, 2000);
            }
        });
    }
</script>
