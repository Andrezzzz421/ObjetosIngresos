@{
    ViewData["Title"] = "Registro Exitoso";
    Layout = "_Layout";
}

<div class="min-h-full flex items-center justify-center py-10 px-4">
    <div class="w-full max-w-lg bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100 p-8 sm:p-12 text-center">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-emerald-50 text-emerald-500 mb-6 shadow-sm ring-8 ring-emerald-50/50">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">¡Pre-Registro Exitoso!</h2>
        <p class="text-slate-500 text-sm mt-3 leading-relaxed">
            Tu información y la de tu equipo han sido vinculadas correctamente en el sistema de inventario y control de ingresos.
        </p>

        <div class="my-6 p-5 bg-slate-50 rounded-2xl border border-slate-100 text-left space-y-2">
            <div class="text-xs text-slate-400 font-bold uppercase tracking-wider">Resumen del Pre-Registro</div>
            <div class="flex justify-between text-sm py-1 border-b border-slate-200/60">
                <span class="text-slate-500">Visitante:</span>
                <span class="font-semibold text-slate-800">@ViewBag.Propietario</span>
            </div>
            <div class="flex justify-between text-sm py-1 border-b border-slate-200/60">
                <span class="text-slate-500">Equipo:</span>
                <span class="font-semibold text-slate-800">@ViewBag.Equipo</span>
            </div>
            <div class="flex justify-between text-sm py-1">
                <span class="text-slate-500">Serial:</span>
                <span class="font-mono text-xs font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">@ViewBag.Serial</span>
            </div>
        </div>

        <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-800 text-left flex items-start gap-3 mb-6">
            <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Al presentarte en la portería del SENA, indícale al personal de seguridad tu <strong>número de documento</strong> para registrar tu ingreso físico de forma inmediata.</span>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-xs hover:bg-slate-50 transition-colors">
                Registrar otro equipo
            </a>
            <a asp-controller="Auth" asp-action="Login" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-sm transition-colors">
                Ir al Inicio
            </a>
        </div>
    </div>
</div>
