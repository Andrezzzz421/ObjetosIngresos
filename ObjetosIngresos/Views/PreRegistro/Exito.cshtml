@{
    ViewData["Title"] = "Registro Exitoso";
}

<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow-md rounded-xl sm:px-10 border border-gray-100 text-center">

            <!-- Icono de éxito -->
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-4">
                <svg class="h-10 w-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>

            <!-- Título y Mensaje -->
            <h2 class="text-2xl font-bold text-gray-900 mb-2">
                ¡Registro Exitoso!
            </h2>
            <p class="text-sm text-gray-600 mb-6">
                El pre-registro del objeto se ha guardado correctamente en el sistema.
            </p>

            <!-- Acciones -->
            <div class="space-y-3">
                <a asp-controller="PreRegistro" asp-action="Index" class="w-full inline-flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition duration-150">
                    Registrar otro objeto
                </a>
            </div>

        </div>
    </div>
</div>