@model ObjetosIngresos.ViewModel.PerfilViewModel
@{
    ViewData["Title"] = "Perfil de usuario";
}

<div class="text-slate-800 font-sans">

    <!-- Breadcrumb & Top Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
        <div>
            <div class="flex items-center space-x-2 text-sm text-slate-500 mb-1">
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Usuarios" asp-action="Index" class="hover:text-indigo-600 transition-colors">Usuarios</a>
                }
                else
                {
                    <a asp-controller="MiPanel" asp-action="Index" class="hover:text-indigo-600 transition-colors">Mi Panel</a>
                }
                <span class="text-slate-400">›</span>
                <span class="text-slate-800 font-semibold">Perfil de usuario</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Perfil de usuario</h1>
            <p class="text-sm text-slate-500">Consulta su información, equipos y actividad de acceso.</p>
        </div>
        <div class="flex items-center space-x-3">
            <button type="button" onclick="abrirModalPassword()" class="flex items-center space-x-2 bg-white border border-slate-300 hover:bg-slate-50 hover:border-slate-400 text-slate-700 px-4 py-2.5 rounded-xl text-sm font-semibold shadow-xs transition duration-150">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                <span>Cambiar contraseña</span>
            </button>
            @if (User.IsInRole("Administrador") || User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && c.Value == "Administrador"))
            {
                <a asp-controller="Usuarios" asp-action="Edit" asp-route-id="@Model.Usuario.IdUsuario" class="flex items-center space-x-2 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-xs transition duration-150">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    <span>Editar perfil</span>
                </a>
            }
        </div>
    </div>

    <!-- User Hero Card -->
    <div class="bg-white rounded-2xl p-6 shadow-xs border border-slate-200 flex flex-col md:flex-row items-start md:items-center justify-between mb-6 gap-6">
        <div>
            <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
                <h2 class="text-xl font-bold text-slate-900 tracking-tight">@Model.NombreCompleto</h2>
                <span class="bg-emerald-50 text-emerald-700 text-xs font-semibold px-2.5 py-0.5 rounded-full border border-emerald-100 flex items-center">
                    <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5"></span> Activo
                </span>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                <span class="bg-indigo-50 text-indigo-700 font-semibold px-2 py-0.5 rounded border border-indigo-100">@Model.TipoUsuarioDescripcion</span>
                <span class="font-medium text-slate-600">ID @Model.CodigoUsuario</span>
                @if (!string.IsNullOrWhiteSpace(Model.Ficha))
                {
                    <span class="text-slate-300">•</span>
                    <span class="font-medium text-slate-600">Ficha: @Model.Ficha</span>
                }
            </div>
        </div>

        <div class="w-full md:w-auto border-t md:border-t-0 md:border-l border-slate-200 pt-4 md:pt-0 md:pl-8 flex items-center space-x-3.5 text-sm">
            <div class="text-indigo-600 mt-0.5 bg-indigo-50 p-2.5 rounded-xl">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
                <p class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">SEDE ASIGNADA</p>
                <p class="font-bold text-slate-800 text-base">@Model.SedeNombre @(string.IsNullOrWhiteSpace(Model.SedeCiudad) ? "" : $"· {Model.SedeCiudad}")</p>
                @if (Model.EstaEnSede)
                {
                    <p class="text-xs text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        @Model.EstadoEnSedeTexto
                    </p>
                }
                else
                {
                    <p class="text-xs text-slate-500 font-medium mt-0.5">@Model.EstadoEnSedeTexto</p>
                }
            </div>
        </div>
    </div>

    <!-- Metric Cards Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Card 1 -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
            <div class="flex justify-between items-start text-slate-500 mb-4">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Equipos vinculados</span>
                <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
                <h3 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-1">@Model.TotalEquipos</h3>
                <p class="text-xs text-slate-400">Registrados a su nombre</p>
            </div>
        </div>

        <!-- Card 2 (Blue Highlight) -->
        <div class="bg-indigo-600 text-white p-5 rounded-2xl shadow-sm flex flex-col justify-between hover:bg-indigo-700 transition-colors">
            <div class="flex justify-between items-start text-indigo-200 mb-4">
                <span class="text-[11px] font-bold text-indigo-200 uppercase tracking-wider">Equipos en sede</span>
                <svg class="w-5 h-5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <div>
                <h3 class="text-3xl font-extrabold text-white tracking-tight mb-1">@Model.EquiposEnSede</h3>
                <p class="text-xs text-indigo-200">De @Model.TotalEquipos vinculados · @Model.EquiposFueraDeSede fuera de sede</p>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
            <div class="flex justify-between items-start text-slate-500 mb-4">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total de movimientos</span>
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path></svg>
            </div>
            <div>
                <h3 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-1">@Model.TotalMovimientos</h3>
                <p class="text-xs text-slate-400">Ingresos y salidas de equipos</p>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-colors">
            <div class="flex justify-between items-start text-slate-500 mb-4">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Último ingreso</span>
                <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-900 mb-1">@Model.UltimoIngresoHora</h3>
                <p class="text-xs text-slate-400">@Model.UltimoIngresoDetalle</p>
            </div>
        </div>
    </div>

    <!-- Grid Layout for Details & Tables -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Left Column: User Technical File (Ficha técnica con SOLO datos reales) -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs h-fit">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
                <h3 class="font-bold text-slate-800 text-base">Ficha técnica del usuario</h3>
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
            </div>

            <div class="space-y-6 text-sm">
                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">Identificación y contacto</p>

                    <div class="mb-3">
                        <p class="text-xs text-slate-400 mb-0.5">Documento de identidad</p>
                        <p class="font-semibold text-slate-800 text-sm">CC · @Model.Usuario.Documento</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-400 mb-0.5">Correo institucional</p>
                        <a href="mailto:@Model.Usuario.Correo" class="font-semibold text-indigo-600 hover:text-indigo-800 transition-colors text-sm break-all">@Model.Usuario.Correo</a>
                    </div>
                </div>

                <hr class="border-slate-100" />

                <div>
                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3">Información institucional</p>

                    <div class="mb-3">
                        <p class="text-xs text-slate-400 mb-0.5">Tipo de usuario / Rol</p>
                        <p class="font-semibold text-slate-800 text-sm">@Model.TipoUsuarioDescripcion</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Ficha))
                    {
                        <div class="mb-3">
                            <p class="text-xs text-slate-400 mb-0.5">Ficha de formación</p>
                            <p class="font-semibold text-slate-800 text-sm">@Model.Ficha</p>
                        </div>
                    }
                    <div>
                        <p class="text-xs text-slate-400 mb-0.5">Sede principal de matrícula</p>
                        <p class="font-semibold text-slate-800 text-sm">@Model.SedeNombre @(string.IsNullOrWhiteSpace(Model.SedeCiudad) ? "" : $"- {Model.SedeCiudad}")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Linked Devices & Recent Movements -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Equipos vinculados Table -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 mb-4 gap-2">
                    <div>
                        <div class="flex items-center space-x-2">
                            <h3 class="font-bold text-slate-800 text-base">Equipos vinculados</h3>
                            <span class="bg-indigo-50 text-indigo-600 font-bold text-xs px-2 py-0.5 rounded-full border border-indigo-100">@Model.TotalEquipos</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-0.5">@Model.EquiposEnSede en sede y @Model.EquiposFueraDeSede fuera de sede.</p>
                    </div>
                    <a asp-controller="MiPanel" asp-action="RegistrarEquipo" class="inline-flex items-center space-x-1 text-indigo-600 hover:text-indigo-700 text-sm font-semibold transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        <span>Vincular equipo</span>
                    </a>
                </div>

                @if (Model.Equipos.Any())
                {
                    <!-- Table Header -->
                    <div class="grid grid-cols-12 text-[11px] font-bold text-slate-400 uppercase tracking-wider pb-2 border-b border-slate-50">
                        <div class="col-span-6">Equipo</div>
                        <div class="col-span-3">Identificación</div>
                        <div class="col-span-3 text-right">Ubicación</div>
                    </div>

                    <!-- Table Rows -->
                    <div class="divide-y divide-slate-100">
                        @foreach (var eq in Model.Equipos)
                        {
                            <div class="grid grid-cols-12 items-center py-3 text-sm hover:bg-slate-50/70 rounded-lg px-1 transition-colors">
                                <div class="col-span-6 flex items-center space-x-3">
                                    <div class="bg-slate-100 p-2.5 rounded-lg text-slate-600 shrink-0">
                                        @if (eq.IconoTipo == "mouse")
                                        {
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v5m0 0a5 5 0 015 5v3a5 5 0 01-10 0v-3a5 5 0 015-5z"></path></svg>
                                        }
                                        else if (eq.IconoTipo == "camera")
                                        {
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        }
                                        else if (eq.IconoTipo == "tablet")
                                        {
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                        }
                                    </div>
                                    <div class="truncate pr-2">
                                        <p class="font-bold text-slate-800 text-sm truncate">@eq.Nombre</p>
                                        <p class="text-xs text-slate-400">@eq.Tipo</p>
                                    </div>
                                </div>
                                <div class="col-span-3">
                                    <p class="font-semibold text-slate-700 text-xs">@eq.Codigo</p>
                                    <p class="text-[11px] text-slate-400 truncate">S/N @eq.Serial</p>
                                </div>
                                <div class="col-span-3 flex items-center justify-end space-x-2">
                                    @if (eq.EnSede)
                                    {
                                        <span class="bg-emerald-50 text-emerald-600 border border-emerald-100 text-xs font-semibold px-2.5 py-1 rounded-full flex items-center whitespace-nowrap">
                                            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5"></span> En sede
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-slate-100 text-slate-600 border border-slate-200 text-xs font-semibold px-2.5 py-1 rounded-full flex items-center whitespace-nowrap">
                                            <span class="w-1.5 h-1.5 bg-slate-400 rounded-full mr-1.5"></span> Fuera de sede
                                        </span>
                                    }
                                    <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center space-x-2 text-xs text-slate-400">
                        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>La vinculación se mantiene aunque el equipo esté fuera de sede.</span>
                    </div>
                }
                else
                {
                    <div class="py-10 text-center">
                        <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        <p class="text-slate-600 font-semibold text-sm">No tienes equipos vinculados</p>
                        <p class="text-slate-400 text-xs mt-1">Registra tu equipo para controlar sus ingresos y salidas.</p>
                        <a asp-controller="MiPanel" asp-action="RegistrarEquipo" class="inline-flex items-center space-x-1.5 mt-4 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold shadow-xs transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            <span>Vincular mi primer equipo</span>
                        </a>
                    </div>
                }
            </div>

            <!-- Recent Movements (Movimientos recientes) -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
                    <h3 class="font-bold text-slate-800 text-base">Movimientos recientes</h3>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Movimiento" asp-action="Index" class="text-indigo-600 hover:text-indigo-700 text-sm font-semibold flex items-center space-x-1 transition-colors">
                            <span>Ver todos (@Model.TotalMovimientos)</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="MiPanel" asp-action="Index" class="text-indigo-600 hover:text-indigo-700 text-sm font-semibold flex items-center space-x-1 transition-colors">
                            <span>Ver todos (@Model.TotalMovimientos)</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </a>
                    }
                </div>

                @if (Model.MovimientosRecientes.Any())
                {
                    <div class="divide-y divide-slate-100">
                        @foreach (var mov in Model.MovimientosRecientes)
                        {
                            <div class="py-3.5 flex items-center justify-between hover:bg-slate-50/70 rounded-lg px-1 transition-colors">
                                <div class="flex items-center space-x-3.5">
                                    @if (mov.EsIngreso)
                                    {
                                        <div class="bg-indigo-50 text-indigo-600 p-2.5 rounded-xl shrink-0">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 5l-14 14m0 0h10m-10 0V9"></path></svg>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-slate-100 text-slate-600 p-2.5 rounded-xl shrink-0">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19L19 5m0 0v10m0-10H9"></path></svg>
                                        </div>
                                    }
                                    <div>
                                        <div class="flex items-center space-x-2">
                                            <p class="font-bold text-slate-800 text-sm">@mov.Titulo</p>
                                            <span class="text-slate-300">•</span>
                                            <span class="text-xs text-slate-400">@mov.Ubicacion</span>
                                        </div>
                                        <p class="text-xs text-slate-500 mt-0.5">@mov.DescripcionEquipos</p>
                                    </div>
                                </div>
                                <div class="text-right shrink-0 pl-3">
                                    <p class="text-sm font-bold text-slate-800">@mov.Hora</p>
                                    <p class="text-xs text-slate-400">@mov.Fecha</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-8 text-center text-slate-400 text-sm">
                        No hay movimientos recientes registrados para tus equipos.
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- Modal Cambiar Contraseña -->
<div id="modalCambiarPassword" class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 transform transition-all animate-scale-up">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-50 text-indigo-600 p-2 rounded-xl">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-lg">Cambiar contraseña</h3>
                    <p class="text-xs text-slate-500">Actualiza las credenciales de tu cuenta</p>
                </div>
            </div>
            <button type="button" onclick="cerrarModalPassword()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <form id="formCambiarPassword" onsubmit="enviarCambioPassword(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@Model.Usuario.Correo" />

            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Nueva Contraseña</label>
                    <input type="password" id="inputNuevaPass" name="password" required minlength="6"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                           placeholder="Mínimo 6 caracteres" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Confirmar Contraseña</label>
                    <input type="password" id="inputConfirmPass" name="confirmarPassword" required minlength="6"
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm"
                           placeholder="Repite la contraseña" />
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3">
                <button type="button" onclick="cerrarModalPassword()" class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-50 transition">
                    Cancelar
                </button>
                <button type="submit" id="btnGuardarPass" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-xs transition flex items-center space-x-2">
                    <span>Guardar cambio</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalPassword() {
        document.getElementById('modalCambiarPassword').classList.remove('hidden');
    }

    function cerrarModalPassword() {
        document.getElementById('modalCambiarPassword').classList.add('hidden');
        document.getElementById('formCambiarPassword').reset();
    }

    async function enviarCambioPassword(e) {
        e.preventDefault();
        const pass = document.getElementById('inputNuevaPass').value;
        const confirm = document.getElementById('inputConfirmPass').value;

        if (pass.length < 6) {
            Swal.fire({
                icon: 'warning',
                title: 'Contraseña corta',
                text: 'La contraseña debe tener al menos 6 caracteres.',
                confirmButtonColor: '#4f46e5'
            });
            return;
        }

        if (pass !== confirm) {
            Swal.fire({
                icon: 'error',
                title: 'No coinciden',
                text: 'Las contraseñas no coinciden. Por favor verifica.',
                confirmButtonColor: '#4f46e5'
            });
            return;
        }

        const btn = document.getElementById('btnGuardarPass');
        btn.disabled = true;
        btn.innerHTML = '<span>Guardando...</span>';

        const formData = new FormData(document.getElementById('formCambiarPassword'));

        try {
            const resp = await fetch('/Auth/ActualizarPassword', {
                method: 'POST',
                body: formData
            });

            if (resp.ok || resp.redirected) {
                cerrarModalPassword();
                Swal.fire({
                    icon: 'success',
                    title: '¡Contraseña actualizada!',
                    text: 'Tu contraseña ha sido cambiada correctamente.',
                    confirmButtonColor: '#4f46e5'
                });
            } else {
                throw new Error();
            }
        } catch (err) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'No se pudo actualizar la contraseña. Inténtalo de nuevo o usa el enlace de recuperación.',
                confirmButtonColor: '#4f46e5'
            });
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<span>Guardar cambio</span>';
        }
    }
</script>