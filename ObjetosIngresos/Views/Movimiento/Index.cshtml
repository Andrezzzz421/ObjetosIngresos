@{
    ViewData["Title"] = "Control de Ingresos";
    var sedes = ViewBag.Sedes as List<ObjetosIngresos.Models.Sede> ?? new();
}

<!-- Modal de foto ampliada -->
<div id="modal-foto" class="fixed inset-0 z-[200] flex items-center justify-center p-4 hidden">
    <div class="absolute inset-0 bg-slate-900/80 backdrop-blur-sm" onclick="cerrarModalFoto()"></div>
    <div class="relative z-10 max-w-2xl w-full">
        <button onclick="cerrarModalFoto()"
                class="absolute -top-4 -right-4 w-9 h-9 bg-white rounded-full flex items-center justify-center shadow-lg hover:bg-slate-100 transition-colors z-20">
            <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
        <img id="modal-foto-img" src="" alt="Foto del equipo"
             class="w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl"/>
    </div>
</div>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-8">

    <!-- ── Encabezado ── -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Control de Ingresos</h1>
            <p class="text-sm text-slate-500 mt-1">Busca un equipo por documento o serie para registrar entrada o salida.</p>
        </div>
    </div>

    <!-- ── Dashboard Stats ── -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900">@(ViewBag.TotalEquipos ?? 0)</p>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-0.5">Equipos Totales</p>
            </div>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900">@(ViewBag.EquiposDentro ?? 0)</p>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-0.5">Equipos Dentro</p>
            </div>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900">@(ViewBag.EquiposIngresadosHoy ?? 0)</p>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-0.5">Ingresos Hoy</p>
            </div>
        </div>
    </div>

    <!-- ── Barra de búsqueda ── -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-5">
        <div class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-grow">
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input id="input-busqueda" type="text" placeholder="Documento de identidad o número de serie..."
                       class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-slate-800 placeholder:text-slate-300"/>
            </div>
            <button id="btn-buscar"
                    class="flex items-center justify-center gap-2 bg-indigo-600 text-white font-semibold px-6 py-3.5 rounded-xl hover:bg-indigo-500 transition-colors shadow-md shadow-indigo-600/20 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                Buscar
            </button>
        </div>
    </div>

    <!-- ── Resultados ── -->
    <div id="seccion-resultados" class="space-y-4 hidden">
        <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider">Resultados de búsqueda</h2>
        <div id="contenedor-resultados" class="space-y-4"></div>
    </div>

    <!-- ── Estado vacío de búsqueda ── -->
    <div id="estado-sin-resultados" class="hidden text-center py-14">
        <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <p class="font-semibold text-slate-600">Sin resultados</p>
        <p class="text-sm text-slate-400 mt-1">No se encontraron equipos con ese criterio de búsqueda.</p>
    </div>

    <!-- ── Loading ── -->
    <div id="loading" class="hidden flex justify-center py-10">
        <div class="w-10 h-10 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin"></div>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Selector de sede (hidden, usado por CheckIn) -->
<select id="select-sede-global" class="hidden">
    <option value="">— Seleccione sede —</option>
    @foreach (var s in sedes)
    {
        <option value="@s.IdSede">@s.NombreSede</option>
    }
</select>

@section Scripts {
    <script src="~/js/GlobalScript.js" asp-append-version="true"></script>
}