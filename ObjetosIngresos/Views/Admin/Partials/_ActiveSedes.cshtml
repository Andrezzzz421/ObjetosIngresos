@model List<ObjetosIngresos.ViewModel.AdminSedeDto>

<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
        <h3 class="flex items-center gap-2 text-sm font-bold text-slate-900">
            <i data-lucide="bar-chart-2" class="h-4 w-4 text-sky-600"></i>
            Sedes con Mayor Actividad
        </h3>
        <span class="text-xs text-slate-400">Top 5</span>
    </div>
    <div class="space-y-4">
        @if (!Model.Any())
        {
            <p class="text-center text-xs text-slate-400 py-3">Sin movimientos registrados en sedes.</p>
        }
        else
        {
            @foreach (var s in Model)
            {
                <div>
                    <div class="mb-1.5 flex justify-between items-center text-xs">
                        <span class="font-semibold text-slate-700 truncate max-w-[70%]">@s.Sede</span>
                        <span class="font-bold text-sky-700">@s.Total movs</span>
                    </div>
                    <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100"
                         data-admin-progress="@s.Porcentaje">
                        <div class="h-full rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 transition-[width] duration-700 ease-out"
                             style="width: 0%"></div>
                    </div>
                </div>
            }
        }
    </div>
</div>
