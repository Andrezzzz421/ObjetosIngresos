@model ObjetosIngresos.ViewModel.AdminKpiDto

<div class="rounded-2xl border border-amber-200/80 bg-gradient-to-br from-amber-50/60 to-orange-50/30 p-5 shadow-sm">
    <div class="flex items-start justify-between">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-700">
            <i data-lucide="alert-triangle" class="h-5 w-5"></i>
        </div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-amber-700 bg-amber-100/80 px-2 py-0.5 rounded-md">
            Auditoría
        </span>
    </div>
    <div class="mt-3">
        <h3 class="text-sm font-bold text-slate-900">Equipos Sin Movimientos</h3>
        <p class="text-xs text-slate-600 mt-1">
            Hay <span class="font-bold text-amber-700">@Model.ElementosSinMovimiento</span> equipos en el inventario que nunca han registrado una entrada o salida.
        </p>
        <div class="mt-3 flex items-center justify-between pt-3 border-t border-amber-200/60">
            <span class="text-xs text-slate-500">Histórico total: @Model.TotalMovimientos regs</span>
            <a href="@Url.Action("Index","Elementos")"
               class="text-xs font-bold text-amber-800 hover:text-amber-950 transition-colors flex items-center gap-1">
                Revisar inventario
                <i data-lucide="chevron-right" class="h-3.5 w-3.5"></i>
            </a>
        </div>
    </div>
</div>
