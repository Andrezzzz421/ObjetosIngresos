@model ObjetosIngresos.Models.AdminDashboardViewModel

@* ══════════════════════════════════════════════════════════════════════════════
   HERO BANNER CON ESTADO DEL SISTEMA Y METADATOS
══════════════════════════════════════════════════════════════════════════════ *@
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-950 via-indigo-900 to-indigo-700 p-6 sm:p-8 mb-6 shadow-lg shadow-indigo-950/20">
    @* Elementos decorativos de fondo *@
    <div class="pointer-events-none absolute -top-16 -right-10 h-72 w-72 rounded-full bg-indigo-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 left-10 h-64 w-64 rounded-full bg-violet-500/15 blur-3xl"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
            <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-indigo-500/30 text-indigo-200 border border-indigo-400/20">
                    <i data-lucide="shield-check" class="h-3.5 w-3.5 text-indigo-300"></i>
                    Panel Administrativo
                </span>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                    En línea
                </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
                Bienvenido, @Model.NombreAdmin
            </h1>
            <p class="mt-1.5 text-sm text-indigo-200 max-w-2xl">
                Monitoreo global, métricas operativas y administración centralizada del Sistema de Ingreso de Objetos.
            </p>

            @* Píldoras de infraestructura rápida *@
            <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-indigo-300">
                <span class="inline-flex items-center gap-1 bg-white/10 px-2.5 py-1 rounded-lg backdrop-blur-sm">
                    <i data-lucide="calendar" class="h-3.5 w-3.5"></i>
                    <span class="capitalize">@Model.FechaHoy</span>
                </span>
                <span class="inline-flex items-center gap-1 bg-white/10 px-2.5 py-1 rounded-lg backdrop-blur-sm">
                    <i data-lucide="map-pin" class="h-3.5 w-3.5"></i>
                    <span>@Model.Kpis.TotalSedes Sedes</span>
                </span>
                <span class="inline-flex items-center gap-1 bg-white/10 px-2.5 py-1 rounded-lg backdrop-blur-sm">
                    <i data-lucide="building-2" class="h-3.5 w-3.5"></i>
                    <span>@Model.Kpis.TotalCentros Centros</span>
                </span>
                <span class="inline-flex items-center gap-1 bg-white/10 px-2.5 py-1 rounded-lg backdrop-blur-sm">
                    <i data-lucide="globe" class="h-3.5 w-3.5"></i>
                    <span>@Model.Kpis.TotalRegionales Regionales</span>
                </span>
            </div>
        </div>

        @* Botones de acción del Hero *@
        <div class="flex items-center gap-2.5 shrink-0">
            <button type="button"
                    data-admin-action="refresh"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold backdrop-blur-sm border border-white/10 transition-all duration-200 active:scale-95 shadow-sm">
                <i data-lucide="refresh-cw" class="h-4 w-4 transition-transform duration-500"></i>
                <span>Actualizar Datos</span>
            </button>
            <a href="@Url.Action("Index", "Movimiento")"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white text-xs font-bold transition-all duration-200 shadow-sm active:scale-95">
                <i data-lucide="scan-line" class="h-4 w-4"></i>
                <span>Nuevo Ingreso</span>
            </a>
        </div>
    </div>
</div>
