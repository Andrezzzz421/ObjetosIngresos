@model List<ObjetosIngresos.Models.AdminMovimientoDto>

@* ══════════════════════════════════════════════════════════════════════════════
   TABLA INTERACTIVA DE MOVIMIENTOS RECIENTES
══════════════════════════════════════════════════════════════════════════════ *@
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden flex flex-col">

    @* Cabecera de la tabla con buscador y filtros de estado *@
    <div class="border-b border-slate-100 p-5">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
                    <i data-lucide="clock" class="h-5 w-5 text-indigo-600"></i>
                    Movimientos Recientes del Sistema
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">Mostrando los últimos 12 registros de ingreso y salida</p>
            </div>
            <div class="flex items-center gap-2">
                <a href="@Url.Action("Index","Movimiento")"
                   class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition-colors flex items-center gap-1">
                    Ver historial completo
                    <i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>
                </a>
            </div>
        </div>

        @* Barra de búsqueda y selector de filtros *@
        <div class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative flex-1">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400"></i>
                <input type="text"
                       data-admin-search
                       placeholder="Filtrar por propietario, documento, equipo o sede..."
                       class="w-full pl-9 pr-4 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-indigo-500 focus:outline-none transition-colors" />
            </div>
            <div class="flex items-center gap-1.5 p-1 bg-slate-100 rounded-xl shrink-0">
                <button type="button"
                        data-admin-filter="todos"
                        class="px-3 py-1.5 text-xs font-bold rounded-lg bg-indigo-600 text-white shadow-sm transition-all duration-200">
                    Todos
                </button>
                <button type="button"
                        data-admin-filter="dentro"
                        class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition-all duration-200">
                    Dentro
                </button>
                <button type="button"
                        data-admin-filter="salio"
                        class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg transition-all duration-200">
                    Finalizados
                </button>
            </div>
        </div>
    </div>

    @* Contenedor de la tabla *@
    @if (!Model.Any())
    {
        <div class="flex flex-col items-center justify-center py-16 text-slate-400">
            <i data-lucide="inbox" class="h-12 w-12 mb-3 opacity-40"></i>
            <p class="text-sm font-medium">No hay movimientos registrados en la base de datos.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left" id="admin-movements-table">
                <thead>
                    <tr class="bg-slate-50/70 border-b border-slate-100 text-[11px] font-bold uppercase tracking-wider text-slate-400">
                        <th class="px-5 py-3 whitespace-nowrap">Propietario / Doc</th>
                        <th class="px-5 py-3 whitespace-nowrap">Equipo & Serial</th>
                        <th class="px-5 py-3 whitespace-nowrap">Sede</th>
                        <th class="px-5 py-3 whitespace-nowrap">Entrada</th>
                        <th class="px-5 py-3 whitespace-nowrap">Salida</th>
                        <th class="px-5 py-3 whitespace-nowrap text-right">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var mov in Model)
                    {
                        string statusKey = mov.Activo ? "dentro" : "salio";

                        <tr class="hover:bg-slate-50/80 transition-colors"
                            data-admin-row
                            data-status="@statusKey">
                            <td class="px-5 py-3.5 whitespace-nowrap">
                                <p class="text-xs font-bold text-slate-900">@mov.Propietario</p>
                                <p class="text-[11px] text-slate-400 font-mono">Doc: @mov.Documento</p>
                            </td>
                            <td class="px-5 py-3.5 whitespace-nowrap">
                                <p class="text-xs font-semibold text-slate-800">@mov.Equipo</p>
                                <p class="text-[11px] text-slate-400 font-mono">S/N: @mov.Serial</p>
                            </td>
                            <td class="px-5 py-3.5 whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 text-xs text-slate-600">
                                    <i data-lucide="map-pin" class="h-3 w-3 text-slate-400"></i>
                                    @mov.Sede
                                </span>
                            </td>
                            <td class="px-5 py-3.5 whitespace-nowrap text-xs text-slate-600 font-mono">
                                @mov.FechaEntrada
                            </td>
                            <td class="px-5 py-3.5 whitespace-nowrap text-xs font-mono">
                                @if (mov.Activo)
                                {
                                    <span class="text-slate-400 italic">Pendiente salida</span>
                                }
                                else
                                {
                                    <span class="text-slate-600">@mov.FechaSalida</span>
                                }
                            </td>
                            <td class="px-5 py-3.5 whitespace-nowrap text-right">
                                @if (mov.Activo)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-700">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                        Dentro
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600">
                                        <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                        Salió
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mensaje cuando ningún registro coincide con la búsqueda *@
        <div data-admin-search-empty class="hidden flex-col items-center justify-center py-12 text-slate-400">
            <i data-lucide="search-x" class="h-10 w-10 mb-2 opacity-40"></i>
            <p class="text-xs font-medium">No se encontraron movimientos que coincidan con la búsqueda.</p>
        </div>
    }
</div>
