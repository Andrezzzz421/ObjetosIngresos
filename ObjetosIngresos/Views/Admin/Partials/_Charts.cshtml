@model ObjetosIngresos.ViewModel.AdminDashboardViewModel
@using System.Text.Json

@{
    var diasJson = JsonSerializer.Serialize(Model.MovimientosUltimos7Dias.Select(d => d.Fecha));
    var entradasJson = JsonSerializer.Serialize(Model.MovimientosUltimos7Dias.Select(d => d.Entradas));
    var salidasJson = JsonSerializer.Serialize(Model.MovimientosUltimos7Dias.Select(d => d.Salidas));

    var equiposLabels = JsonSerializer.Serialize(Model.DistribucionEquipos.Select(e => e.Tipo));
    var equiposData = JsonSerializer.Serialize(Model.DistribucionEquipos.Select(e => e.Cantidad));
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Gráfica de Barras: Flujo 7 días (2 columnas en LG) -->
    <div class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
            <div>
                <h3 class="flex items-center gap-2 text-sm font-bold text-slate-900">
                    <svg class="h-4 w-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                    </svg>
                    Flujo de Movimientos (Últimos 7 días)
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Comparativa de ingresos y salidas diarias registradas en el sistema</p>
            </div>
            <div class="flex items-center gap-3 text-xs font-semibold">
                <span class="inline-flex items-center gap-1.5 text-indigo-600">
                    <span class="w-3 h-3 rounded-full bg-indigo-600"></span> Entradas
                </span>
                <span class="inline-flex items-center gap-1.5 text-amber-500">
                    <span class="w-3 h-3 rounded-full bg-amber-500"></span> Salidas
                </span>
            </div>
        </div>

        <div class="relative w-full" style="height: 260px;">
            <canvas id="chartMovimientosSemana"></canvas>
        </div>
    </div>

    <!-- Gráfica de Dona: Proporción de Tipos de Equipo (1 columna en LG) -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm flex flex-col justify-between">
        <div>
            <div class="flex items-center justify-between mb-4">
                <h3 class="flex items-center gap-2 text-sm font-bold text-slate-900">
                    <svg class="h-4 w-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
                    </svg>
                    Distribución de Equipos
                </h3>
                <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600">
                    @Model.Kpis.TotalElementos total
                </span>
            </div>

            <div class="relative w-full flex items-center justify-center my-auto" style="height: 210px;">
                <canvas id="chartDistribucionEquipos"></canvas>
            </div>
        </div>

        <p class="text-[11px] text-center text-slate-400 mt-2">
            Top tipos registrados en el inventario institucional
        </p>
    </div>
</div>

<!-- Carga de Chart.js y renderizado limpio -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    (function () {
        const textCol = '#64748b';
        const gridCol = 'rgba(226, 232, 240, 0.8)';

        // Datos inyectados desde Razor
        const dias = @Html.Raw(diasJson);
        const entradas = @Html.Raw(entradasJson);
        const salidas = @Html.Raw(salidasJson);
        const equiposLabels = @Html.Raw(equiposLabels);
        const equiposData = @Html.Raw(equiposData);

        // 1. Gráfica de Barras de Flujo
        const ctxMov = document.getElementById('chartMovimientosSemana')?.getContext('2d');
        if (ctxMov) {
            new Chart(ctxMov, {
                type: 'bar',
                data: {
                    labels: dias,
                    datasets: [
                        {
                            label: 'Entradas',
                            data: entradas,
                            backgroundColor: 'rgba(79, 70, 229, 0.85)',
                            hoverBackgroundColor: 'rgba(67, 56, 202, 1)',
                            borderRadius: 6,
                            borderSkipped: false,
                            maxBarThickness: 28
                        },
                        {
                            label: 'Salidas',
                            data: salidas,
                            backgroundColor: 'rgba(245, 158, 11, 0.85)',
                            hoverBackgroundColor: 'rgba(217, 119, 6, 1)',
                            borderRadius: 6,
                            borderSkipped: false,
                            maxBarThickness: 28
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#f8fafc',
                            bodyColor: '#e2e8f0',
                            padding: 10,
                            cornerRadius: 8
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: textCol, font: { size: 11, family: 'Inter, sans-serif' } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: gridCol },
                            ticks: {
                                precision: 0,
                                color: textCol,
                                font: { size: 11, family: 'Inter, sans-serif' }
                            }
                        }
                    }
                }
            });
        }

        // 2. Gráfica de Dona: Distribución de Equipos
        const ctxEquipos = document.getElementById('chartDistribucionEquipos')?.getContext('2d');
        if (ctxEquipos) {
            const palette = [
                '#4f46e5', // Indigo
                '#06b6d4', // Cyan
                '#10b981', // Emerald
                '#f59e0b', // Amber
                '#ec4899', // Pink
                '#8b5cf6'  // Purple
            ];

            new Chart(ctxEquipos, {
                type: 'doughnut',
                data: {
                    labels: equiposLabels.length ? equiposLabels : ['Sin registros'],
                    datasets: [{
                        data: equiposData.length ? equiposData : [1],
                        backgroundColor: palette.slice(0, Math.max(equiposLabels.length, 1)),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 10,
                                boxHeight: 10,
                                color: textCol,
                                font: { size: 11 }
                            }
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#f8fafc',
                            bodyColor: '#e2e8f0',
                            padding: 10,
                            cornerRadius: 8
                        }
                    }
                }
            });
        }
    })();
</script>
