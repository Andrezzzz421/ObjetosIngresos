@{
    ViewData["Title"] = "Editar Equipo";
    var marcas = ViewBag.Marcas as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var tiposDetalle = ViewBag.TiposDetalle as List<ObjetosIngresos.Models.TiposDetalle>;
    int idElemento = ViewBag.IdElemento ?? 0;
    string tipoElemento = ViewBag.TipoElemento ?? "";
    int? idMarca = ViewBag.IdMarca;
    string serial = ViewBag.Serial ?? "";
    bool tieneFoto = ViewBag.TieneFoto ?? false;
    var accesoriosActuales = ViewBag.Accesorios as List<int> ?? new List<int>();
}

<style>
    .edit-hero { background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%); }
</style>

<div class="max-w-2xl mx-auto px-4 py-5 space-y-5">

    <!-- Header -->
    <div class="edit-hero rounded-3xl p-6 text-white shadow-xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-48 h-48 rounded-full opacity-10 pointer-events-none"
             style="background:radial-gradient(circle,#a5b4fc,transparent);transform:translate(30%,-30%)"></div>
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center shrink-0"
                 style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25)">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
            </div>
            <div>
                <h1 class="text-xl font-black tracking-tight text-white">Editar Equipo</h1>
                <p class="text-sm text-indigo-200 mt-0.5">Actualiza la información de tu dispositivo registrado.</p>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Exito"] != null)
    {
        <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl px-4 py-3 text-sm font-medium">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>@TempData["Exito"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flex items-center gap-3 bg-rose-50 border border-rose-200 text-rose-900 rounded-2xl px-4 py-3 text-sm font-medium">
            <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Formulario -->
    <form asp-controller="MiPanel" asp-action="EditarEquipo" method="post" enctype="multipart/form-data"
          class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">

        @Html.AntiForgeryToken()
        <input type="hidden" name="idElemento" value="@idElemento" />

        <div class="p-5 space-y-5">

            <!-- Tipo de equipo -->
            <div>
                <label class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-1 block">
                    Tipo de Equipo *
                </label>
                <input type="text" name="tipoElemento" value="@tipoElemento" required maxlength="50"
                       placeholder="Ej. Laptop, Portátil, Tablet..."
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" />
            </div>

            <!-- Marca -->
            <div>
                <label class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-1 block">Marca</label>
                <select name="idMarca"
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white">
                    <option value="">— Sin marca —</option>
                    @if (marcas != null)
                    {
                        foreach (var m in marcas)
                        {
                            <option value="@m.Value" selected="@(m.Value == idMarca?.ToString() ? "selected" : null)">@m.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Serial -->
            <div>
                <label class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-1 block">
                    Número de Serie
                </label>
                <input type="text" name="serial" value="@serial" maxlength="50"
                       placeholder="Ej. SN-2024-ABCDE"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-mono text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" />
                <p class="text-xs text-slate-400 mt-1">Déjalo vacío si no aplica.</p>
            </div>

            <!-- Foto -->
            <div>
                <label class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-2 block">
                    Foto del Equipo
                </label>
                @if (tieneFoto)
                {
                    <div class="flex items-center gap-3 mb-3">
                        <img src="@Url.Action("ObtenerImagen", "Elementos", new { id = idElemento })"
                             alt="Foto actual" class="w-16 h-16 rounded-xl object-cover border border-slate-200 shadow-sm" />
                        <div>
                            <p class="text-xs font-semibold text-slate-700">Foto actual</p>
                            <p class="text-[11px] text-slate-400">Sube una nueva para reemplazarla</p>
                        </div>
                    </div>
                }
                <label class="flex flex-col items-center justify-center w-full h-28 border-2 border-dashed border-slate-300 hover:border-indigo-400 rounded-xl cursor-pointer bg-slate-50 hover:bg-indigo-50/30 transition-all group">
                    <svg class="w-7 h-7 text-slate-400 group-hover:text-indigo-500 mb-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span id="foto-label" class="text-xs font-medium text-slate-500 group-hover:text-indigo-600 transition-colors">
                        @(tieneFoto ? "Subir nueva foto (reemplaza la actual)" : "Subir fotografía del equipo")
                    </span>
                    <input type="file" name="foto" accept="image/*" class="hidden" id="foto-input"
                           onchange="document.getElementById('foto-label').textContent = this.files[0]?.name || 'Sin archivo'" />
                </label>
            </div>

            <!-- Accesorios -->
            @if (tiposDetalle != null && tiposDetalle.Any())
            {
                <div>
                    <label class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-2 block">
                        Accesorios / Objetos Vinculados
                    </label>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        @foreach (var td in tiposDetalle)
                        {
                            bool marcado = accesoriosActuales.Contains(td.IdTipoDetalle);
                            <label class="flex items-center gap-2 p-2.5 rounded-xl border cursor-pointer transition-all duration-150 select-none @(marcado ? "bg-indigo-50 border-indigo-200" : "bg-slate-50 border-slate-200 hover:border-indigo-300")">
                                <input type="checkbox" name="accesorios" value="@td.IdTipoDetalle"
                                       @(marcado ? "checked" : "")
                                       class="w-3.5 h-3.5 text-indigo-600 rounded focus:ring-indigo-500 border-slate-300" />
                                <span class="text-xs font-medium text-slate-700">@td.Nombre</span>
                            </label>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Pie del form -->
        <div class="px-5 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-3">
            <a asp-controller="MiPanel" asp-action="Index"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-200 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Cancelar
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-sm font-bold text-white shadow-sm transition-all hover:opacity-90 active:scale-95"
                    style="background:linear-gradient(135deg,#6366f1,#4f46e5)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                Guardar Cambios
            </button>
        </div>
    </form>
</div>
