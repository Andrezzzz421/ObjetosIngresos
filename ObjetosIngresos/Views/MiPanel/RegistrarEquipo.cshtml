@model dynamic

@{
    ViewData["Title"] = "Registrar Equipos";
    Layout = "_Layout";
}

<style>
    /* Estilos de respaldo para asegurar el maquetado en caso de fallos de compilación CSS */
    .form-container-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        width: 100%;
    }

    .col-foto {
        flex: 1 1 280px;
        max-width: 100%;
    }

    .col-inputs {
        flex: 2 1 320px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }

    .row-inputs-inline {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        width: 100%;
    }

    .col-half {
        flex: 1 1 200px;
        min-width: 0;
    }

    .custom-input, .custom-select {
        width: 100% !important;
        box-sizing: border-box !important;
        display: block !important;
    }
</style>

<div class="max-w-4xl mx-auto px-4 py-8 w-full">
    <!-- Encabezado -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <a href="@Url.Action("Index", "MiPanel")"
               class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-indigo-600 font-medium transition-colors mb-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Volver a mi panel
            </a>
            <h1 class="text-2xl font-bold text-slate-900">Registrar nuevos equipos</h1>
            <p class="text-sm text-slate-500 mt-0.5">Agrega uno o varios equipos junto con sus accesorios antes de guardar.</p>
        </div>

        <div class="bg-indigo-50 border border-indigo-100 rounded-2xl px-4 py-2.5 flex items-center gap-3 self-start md:self-auto">
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600">En lista:</span>
            <span id="badge-contador" class="text-lg font-bold text-indigo-700">0 equipos</span>
        </div>
    </div>

    <!-- Formulario Borrador / Captura de Equipos -->
    <div class="bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden p-6 mb-8 w-full">
        <h2 class="text-lg font-bold text-slate-800 mb-6 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs font-bold shrink-0">1</span>
            Datos del Equipo
        </h2>

        <!-- Layout Grid/Flex Contenedor del Formulario -->
        <div class="form-container-grid mb-6">
            <!-- Carga de Fotografía -->
            <div class="col-foto">
                <label class="block text-sm font-semibold text-slate-700 mb-2">Fotografía</label>

                <div class="relative w-full rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 hover:bg-slate-100/50 transition-all flex flex-col items-center justify-center overflow-hidden group"
                     style="height: 192px !important; min-height: 192px !important;">

                    <input type="file"
                           id="foto"
                           name="foto"
                           accept="image/*"
                           class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer">

                    <div id="upload-placeholder" class="p-4 text-center pointer-events-none">
                        <div class="w-10 h-10 bg-white rounded-xl mx-auto flex items-center justify-center shadow-sm border border-slate-200 group-hover:scale-110 transition-transform mb-2">
                            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <span class="text-xs font-semibold text-slate-600 block">Subir imagen</span>
                    </div>

                    <img id="preview"
                         src=""
                         alt="Vista previa"
                         class="hidden rounded-2xl pointer-events-none z-0"
                         style="width: 100% !important; height: 100% !important; object-fit: cover !important;" />
                </div>
            </div>

            <!-- Campos Principales -->
            <div class="col-inputs">
                <div class="w-full">
                    <label for="temp-tipo" class="block text-sm font-semibold text-slate-700 mb-1">
                        Tipo de Elemento <span class="text-red-500">*</span>
                    </label>
                    <select id="temp-tipo"
                            class="custom-select w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none text-slate-800 text-sm bg-white">
                        <option value="">Seleccione un tipo...</option>
                        <option value="Laptop">Laptop / Portátil</option>
                        <option value="Tablet">Tablet</option>
                        <option value="Monitor">Monitor</option>
                        <option value="Cámara">Cámara</option>
                        <option value="Herramienta">Herramienta</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <div id="contenedor-otro-temp" class="hidden mt-2 w-full">
                        <input type="text" id="temp-otro-tipo" placeholder="Especificar tipo..."
                               class="custom-input w-full px-4 py-2 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 outline-none" />
                    </div>
                </div>

                <div class="row-inputs-inline">
                    <div class="col-half">
                        <label for="temp-marca" class="block text-sm font-semibold text-slate-700 mb-1">Marca</label>
                        <select id="temp-marca" class="custom-select w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none text-slate-800 text-sm bg-white">
                            <option value="">Sin marca / Otra</option>
                            @if (ViewBag.Marcas != null)
                            {
                                foreach (var m in (IEnumerable<SelectListItem>)ViewBag.Marcas)
                                {
                                    <option value="@m.Value">@m.Text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-half">
                        <label for="temp-serial" class="block text-sm font-semibold text-slate-700 mb-1">Número de Serie</label>
                        <input id="temp-serial" type="text" placeholder="Ej: SN12345678"
                               class="custom-input w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-indigo-500 outline-none text-slate-800 text-sm" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Accesorios u Objetos Adicionales -->
        <div class="border-t border-slate-100 pt-4 w-full">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <span class="text-sm font-bold text-slate-800">Accesorios u Objetos Adicionales (Opcional)</span>
                <span class="text-xs text-slate-400">Cargador, funda, mouse, etc.</span>
            </div>

            <div class="flex flex-col md:flex-row gap-2 mb-3 w-full">
                <select id="temp-tipo-accesorio"
                        class="custom-select flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white text-slate-800">
                    <option value="">-- Seleccione un accesorio --</option>
                    @if (ViewBag.TiposDetalle != null)
                    {
                        foreach (var tipo in ViewBag.TiposDetalle)
                        {
                            <option value="@tipo.IdTipoDetalle">@tipo.Nombre</option>
                        }
                    }
                    <option value="Otro" class="font-semibold text-indigo-600">+ Otro / Escribir manualmente</option>
                </select>

                <div id="contenedor-otro-accesorio" style="display: none;" class="flex-1">
                    <input type="text"
                           id="temp-nuevo-accesorio"
                           placeholder="Escriba el nombre del accesorio..."
                           class="custom-input w-full px-4 py-2.5 rounded-xl border border-indigo-300 bg-indigo-50/30 text-sm focus:ring-2 focus:ring-indigo-500 outline-none text-slate-800" />
                </div>

                <input type="text"
                       id="temp-detalle-input"
                       placeholder="Nota (Ej: 65W, Color Negro)..."
                       class="custom-input flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 outline-none text-slate-800" />

                <!-- Input de Foto para el accesorio -->
                <div class="flex items-center gap-2 shrink-0">
                    <input type="file" id="temp-foto-accesorio" accept="image/*" capture="environment" class="hidden" />
                    <label for="temp-foto-accesorio" id="lbl-foto-accesorio"
                           class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium transition-all shadow-sm"
                           title="Tomar o adjuntar foto del accesorio">
                        <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span id="txt-foto-accesorio">Foto</span>
                    </label>
                    <div id="preview-box-accesorio" class="hidden relative">
                        <img id="preview-img-accesorio" class="w-9 h-9 rounded-lg object-cover border-2 border-indigo-500 shadow-sm" />
                        <button type="button" id="btn-quitar-foto-accesorio" class="absolute -top-1.5 -right-1.5 bg-rose-500 text-white rounded-full w-4 h-4 flex items-center justify-center text-[10px] font-bold shadow hover:bg-rose-600" title="Quitar foto">&times;</button>
                    </div>
                </div>

                <button type="button"
                        id="btn-add-detalle"
                        class="px-5 py-2.5 bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-700 border border-indigo-200 font-semibold text-sm rounded-xl transition-all shrink-0 flex items-center gap-1.5 shadow-2xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Añadir accesorio
                </button>
            </div>

            <div id="lista-detalles-temp" class="flex flex-wrap gap-2 min-h-[42px] p-2 bg-slate-50 rounded-xl border border-slate-100 items-center w-full">
                <span class="text-xs text-slate-400 px-2" id="empty-detalles-msg">No se han añadido accesorios.</span>
            </div>
        </div>

        <!-- Botón de Inclusión Temporal -->
        <div class="mt-6 pt-4 border-t border-slate-100 flex justify-end w-full">
            <button type="button" id="btn-add-equipo"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3 px-6 rounded-xl shadow-md transition-all active:scale-95">
                <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Agregar equipo a la lista
            </button>
        </div>
    </div>

    <!-- Formulario de Envío Definitivo al Servidor -->
    <form asp-action="RegistrarEquipo" asp-controller="MiPanel" method="post" enctype="multipart/form-data" id="form-registro-final" class="w-full">
        @Html.AntiForgeryToken()

        <div class="bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden p-6 mb-8 w-full">
            <h2 class="text-lg font-bold text-slate-800 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs font-bold shrink-0">2</span>
                Equipos Listos para Guardar
            </h2>

            <div id="contenedor-equipos-agregados" class="space-y-3 w-full">
                <div id="mensaje-vacio" class="text-center py-8 text-slate-400">
                    <svg class="w-12 h-12 mx-auto mb-2 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                    </svg>
                    <p class="text-sm">Aún no has agregado equipos a la lista.</p>
                </div>
            </div>
        </div>

        <!-- El contenedor se poblará dinámicamente con inputs hidden desde registrar-equipos.js -->
        <div id="inputs-ocultos-container"></div>

        <button type="submit" id="btn-guardar-todo" disabled
                class="w-full flex items-center justify-center gap-2 bg-indigo-600 text-white font-bold py-4 rounded-xl shadow-lg shadow-indigo-200 hover:bg-indigo-500 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Guardar todos los equipos
        </button>
    </form>
</div>

@section Scripts {
    <script src="~/js/registrar-equipos.js" asp-append-version="true"></script>
}