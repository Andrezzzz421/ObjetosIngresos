<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | SGI</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Notif unread */
        .notif-item.unread { background-color: rgba(238, 242, 255, 0.6); }
    </style>
    <script>
        // Limpieza de cualquier preferencia previa de modo oscuro
        try {
            localStorage.removeItem('sgi-dark');
            document.documentElement.classList.remove('dark');
        } catch (e) {}
    </script>
</head>
<body class="h-full text-slate-800 antialiased flex flex-col md:flex-row overflow-hidden">
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

    @if (ViewData["HideNavbar"] == null)
    {
        <!-- Topbar móvil -->
        <div class="md:hidden bg-slate-900 text-white h-16 flex items-center justify-between px-4 border-b border-slate-800 shrink-0 z-50">
            <div class="flex items-center gap-2">
                <div class="bg-indigo-600 text-white p-1.5 rounded-lg">
                    <span class="font-black text-lg tracking-tighter">SGI</span>
                </div>
                <span class="font-bold text-sm tracking-tight">Sistema de Gestión</span>
            </div>
            <div class="flex items-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Historial" asp-action="Index" title="Historial de movimientos"
                       class="p-2 rounded-lg bg-slate-800 text-indigo-400 hover:text-white hover:bg-slate-700 transition-colors @(currentCtrl.Equals("Historial", StringComparison.OrdinalIgnoreCase) ? "bg-indigo-600 text-white" : "")">
                        <i data-lucide="history" class="w-5 h-5"></i>
                    </a>
                }
                <button id="btn-toggle-sidebar" class="p-2 rounded-lg hover:bg-slate-800 focus:outline-none text-slate-400 hover:text-white transition-colors">
                    <i data-lucide="menu" id="icon-menu" class="w-6 h-6"></i>
                    <i data-lucide="x" id="icon-close" class="w-6 h-6 hidden"></i>
                </button>
            </div>
        </div>

        <!-- Sidebar -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 w-64 bg-slate-900 text-slate-300 flex flex-col border-r border-slate-800 z-40 shrink-0 transition-transform duration-300 ease-in-out h-full pt-16 md:pt-0">
            <div class="hidden md:flex h-16 items-center px-6 border-b border-slate-800 gap-3">
                <div class="bg-indigo-600 text-white p-1.5 rounded-lg shadow-md shadow-indigo-600/20">
                    <span class="font-black text-xl tracking-tighter block leading-none">SGI</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-sm text-white tracking-tight leading-none">Sistema de Gestión</span>
                    <span class="text-[10px] text-slate-500 italic mt-0.5">Objetos e Ingresos</span>
                </div>
            </div>

            <nav class="flex-grow p-4 space-y-1 overflow-y-auto">
                <ul>
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group @(currentCtrl.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "bg-slate-800 text-white" : "")">
                            <i data-lucide="home" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors @(currentCtrl.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "text-indigo-400" : "")"></i>
                            Inicio
                        </a>
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var esAdmin = User.IsInRole("Administrador")
                            || User.HasClaim(c => c.Type == System.Security.Claims.ClaimTypes.Role && (c.Value == "Administrador" || c.Value == "administrador"))
                            || User.IsInRole("Instructor")
                            || User.IsInRole("Admin");

                        <li>
                            <a asp-controller="MiPanel" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group @(currentCtrl.Equals("MiPanel", StringComparison.OrdinalIgnoreCase) ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 font-semibold" : "")">
                                <i data-lucide="layout-dashboard" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors @(currentCtrl.Equals("MiPanel", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                                Mi Panel
                            </a>
                        </li>

                        @if (esAdmin)
                        {
                            <li>
                                <a asp-controller="Movimiento" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group @(currentCtrl.Equals("Movimiento", StringComparison.OrdinalIgnoreCase) ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 font-semibold" : "")">
                                    <i data-lucide="scan-line" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors @(currentCtrl.Equals("Movimiento", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                                    Control de Ingresos
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Historial" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group @(currentCtrl.Equals("Historial", StringComparison.OrdinalIgnoreCase) ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 font-semibold" : "")">
                                    <i data-lucide="history" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors @(currentCtrl.Equals("Historial", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                                    Historial de movimientos
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Elementos" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group @(currentCtrl.Equals("Elementos", StringComparison.OrdinalIgnoreCase) ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 font-semibold" : "")">
                                    <i data-lucide="package" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors @(currentCtrl.Equals("Elementos", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                                    Inventario Global
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Usuarios" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group">
                                    <i data-lucide="users" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors"></i>
                                    Usuarios
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group">
                                    <i data-lucide="shield-check" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors"></i>
                                    Panel Administrativo
                                </a>
                            </li>
                            <li class="relative">
                                <button id="btn-toggle-catalogos" type="button" class="w-full flex items-center justify-between px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group">
                                    <div class="flex items-center gap-3">
                                        <i data-lucide="layout-grid" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors"></i>
                                        <span>Catálogos</span>
                                    </div>
                                    <i data-lucide="chevron-down" id="icon-chevron-catalogos" class="w-4 h-4 text-slate-400 transition-transform duration-200"></i>
                                </button>
                                <ul id="menu-catalogos" class="hidden pl-11 pr-2 py-1 space-y-1 bg-slate-950/20 rounded-xl mt-1">
                                    <li><a asp-controller="Catalogos" asp-action="Index" class="block px-3 py-2 rounded-lg text-sm hover:text-white hover:bg-slate-800 transition-colors">Ver Todo (Inicio)</a></li>
                                    <li><a asp-controller="Catalogos" asp-action="CentrosFormacion" class="block px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">Centros de Formación</a></li>
                                    <li><a asp-controller="Catalogos" asp-action="Marcas" class="block px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">Marcas</a></li>
                                    <li><a asp-controller="Catalogos" asp-action="Regionales" class="block px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">Regionales</a></li>
                                    <li><a asp-controller="Catalogos" asp-action="Sedes" class="block px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">Sedes</a></li>
                                    <li><a asp-controller="Catalogos" asp-action="TiposDetalle" class="block px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">Tipos de Detalle</a></li>
                                    <li><a asp-controller="Catalogos" asp-action="TiposUsuario" class="block px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">Tipos de Usuario</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a asp-controller="Historial" asp-action="Index" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group @(currentCtrl.Equals("Historial", StringComparison.OrdinalIgnoreCase) ? "bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 font-semibold" : "")">
                                    <i data-lucide="history" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors @(currentCtrl.Equals("Historial", StringComparison.OrdinalIgnoreCase) ? "text-white" : "")"></i>
                                    Historial de movimientos
                                </a>
                            </li>
                        }

                        <li>
                            <a asp-controller="Auth" asp-action="Perfil" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group">
                                <i data-lucide="user" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors"></i>
                                Perfil
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="pt-2 mt-2">
                            <a asp-controller="Auth" asp-action="Login" class="flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold shadow-lg shadow-indigo-600/30 transition-all duration-300 hover:-translate-y-0.5 group">
                                <i data-lucide="log-in" class="w-5 h-5 text-indigo-100 group-hover:text-white transition-colors"></i>
                                <span>Iniciar Sesión</span>
                            </a>
                        </li>
                    }

                    <li>
                        <a asp-controller="Home" asp-action="SaberMas" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-slate-800 hover:text-white font-medium transition-all duration-200 group">
                            <i data-lucide="help-circle" class="w-5 h-5 text-slate-400 group-hover:text-indigo-400 transition-colors"></i>
                            Ayuda
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Footer sidebar -->
            <div class="p-4 border-t border-slate-800 bg-slate-950/40 text-xs space-y-3">

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div>
                        <form id="logout-form" asp-controller="Auth" asp-action="Logout" method="post" class="hidden">
                            @Html.AntiForgeryToken()
                        </form>
                        <button id="btn-logout" type="button" class="w-full flex items-center justify-center gap-3 px-4 py-3 rounded-xl bg-rose-500/10 text-rose-400 hover:bg-rose-500 hover:text-white font-medium transition-all duration-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-rose-500/40 group">
                            <i data-lucide="log-out" class="w-5 h-5 transition-colors"></i>
                            <span class="tracking-wide text-sm font-semibold">Cerrar Sesión</span>
                        </button>
                    </div>
                }
            </div>
        </aside>

        <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-30 hidden md:hidden transition-opacity"></div>
    }

    <div class="flex-grow flex flex-col min-w-0 overflow-hidden relative">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var nombreUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Usuario";
            var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Personal";
            var inicial = !string.IsNullOrEmpty(nombreUsuario) ? nombreUsuario.Substring(0, 1).ToUpper() : "U";

            <!-- Topbar escritorio: nombre + campana + avatar -->
            <div class="hidden md:flex items-center justify-end gap-3 px-6 py-3 border-b border-slate-200 bg-white/90 backdrop-blur-sm shrink-0">
                <span class="text-xs text-slate-500 font-medium">@nombreUsuario</span>
                <span class="text-xs px-2 py-0.5 rounded-full font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">@rolUsuario</span>

                <!-- Acceso directo a Historial de movimientos -->
                <a asp-controller="Historial" asp-action="Index"
                   class="p-2 rounded-xl hover:bg-slate-100 text-slate-500 hover:text-indigo-600 transition-all duration-200 @(currentCtrl.Equals("Historial", StringComparison.OrdinalIgnoreCase) ? "text-indigo-600 bg-indigo-50 font-semibold" : "")"
                   title="Historial de movimientos">
                    <i data-lucide="history" class="w-5 h-5"></i>
                </a>

                <!-- Campana de notificaciones -->
                <div class="relative" id="notif-container">
                    <button id="btn-notif" type="button"
                            class="relative p-2 rounded-xl hover:bg-slate-100 text-slate-500 hover:text-indigo-600 transition-all duration-200"
                            title="Notificaciones">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <span id="notif-badge"
                              class="absolute -top-0.5 -right-0.5 w-4 h-4 rounded-full bg-rose-500 text-white text-[9px] font-black flex items-center justify-center hidden">0</span>
                    </button>

                    <!-- Panel de notificaciones -->
                    <div id="notif-panel"
                         class="hidden absolute right-0 top-full mt-2 w-80 bg-white border border-slate-200 rounded-2xl shadow-2xl z-50 overflow-hidden">
                        <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100 bg-slate-50/50">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Notificaciones</span>
                            <button id="btn-mark-all-read" type="button"
                                    class="text-[10px] font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
                                Marcar todas leídas
                            </button>
                        </div>
                        <div id="notif-list" class="max-h-72 overflow-y-auto divide-y divide-slate-100">
                            <div class="flex flex-col items-center justify-center py-8 px-4 text-center">
                                <i data-lucide="bell-off" class="w-8 h-8 text-slate-300 mb-2"></i>
                                <p class="text-xs text-slate-400 font-medium">Sin notificaciones nuevas</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs font-black shadow-sm">
                    @inicial
                </div>
            </div>
        }

        <main role="main" class="flex-grow overflow-y-auto p-4 sm:p-6 md:p-8 animate-fade-in">
            <div class="max-w-7xl mx-auto">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/GlobalScript.js" asp-append-version="true"></script>
    <script src="~/js/excel-exporter.js" asp-append-version="true"></script>
    <script src="~/js/CargarExcel.js" asp-append-version="true"></script>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        /* ── Notificaciones ── */
        var notifBtn   = document.getElementById('btn-notif');
        var notifPanel = document.getElementById('notif-panel');
        var markAll    = document.getElementById('btn-mark-all-read');

        if (notifBtn && notifPanel) {
            notifBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                notifPanel.classList.toggle('hidden');
            });
            document.addEventListener('click', function (e) {
                var nc = document.getElementById('notif-container');
                if (nc && !nc.contains(e.target)) { notifPanel.classList.add('hidden'); }
            });
        }

        if (markAll) {
            markAll.addEventListener('click', function () {
                var badge = document.getElementById('notif-badge');
                if (badge) { badge.classList.add('hidden'); }
                document.querySelectorAll('.notif-item.unread').forEach(function (el) {
                    el.classList.remove('unread');
                    el.style.backgroundColor = '';
                });
                var token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
                fetch('/Notificaciones/MarcarTodasLeidas', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                }).catch(function(){});
            });
        }

        function renderNotificaciones(items) {
            var lista = document.getElementById('notif-list');
            if (!lista) return;
            var badge = document.getElementById('notif-badge');
            var noLeidas = items.filter(function(n){ return !n.leida; }).length;

            if (badge) {
                if (noLeidas > 0) {
                    badge.classList.remove('hidden');
                    badge.textContent = noLeidas > 9 ? '9+' : noLeidas;
                } else {
                    badge.classList.add('hidden');
                }
            }

            if (!items.length) {
                lista.innerHTML = '<div class="flex flex-col items-center justify-center py-8 px-4 text-center"><i data-lucide="bell-off" class="w-8 h-8 text-slate-300 mb-2"></i><p class="text-xs text-slate-400 font-medium">Sin notificaciones nuevas</p></div>';
            } else {
                lista.innerHTML = items.map(function(n) {
                    var ic = n.tipo === 'entrada' ? 'text-emerald-600 bg-emerald-50' : n.tipo === 'salida' ? 'text-amber-600 bg-amber-50' : 'text-indigo-600 bg-indigo-50';
                    var ig = n.tipo === 'entrada' ? 'log-in' : n.tipo === 'salida' ? 'log-out' : 'bell';
                    return '<div class="notif-item flex items-start gap-3 px-4 py-3 hover:bg-slate-50 transition-colors cursor-default ' + (!n.leida ? 'unread' : '') + '" data-id="' + n.id + '">'
                        + '<div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 ' + ic + '"><i data-lucide="' + ig + '" class="w-4 h-4"></i></div>'
                        + '<div class="min-w-0 flex-1"><p class="text-xs font-bold text-slate-800 leading-tight">' + n.titulo + '</p>'
                        + '<p class="text-[11px] text-slate-500 mt-0.5 leading-snug">' + n.mensaje + '</p>'
                        + '<p class="text-[10px] text-slate-400 mt-1">' + n.fecha + '</p></div>'
                        + (!n.leida ? '<span class="w-2 h-2 rounded-full bg-indigo-500 shrink-0 mt-1.5"></span>' : '')
                        + '</div>';
                }).join('');
            }
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        function cargarNotificaciones() {
            fetch('/Notificaciones/ObtenerRecientes')
                .then(function(r){ return r.ok ? r.json() : null; })
                .then(function(data){ if (data && data.success) renderNotificaciones(data.notificaciones || []); })
                .catch(function(){});
        }

        if (document.getElementById('notif-container')) {
            cargarNotificaciones();
        }
    });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>