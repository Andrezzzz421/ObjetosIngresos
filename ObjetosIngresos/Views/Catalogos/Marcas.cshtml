@model List<ObjetosIngresos.Models.Marca>
@{
    ViewData["Title"] = "Administración de Marcas";
}

<div class="container mx-auto px-6 py-8">
    <div class="mb-4">
        <a href="@Url.Action("Index", "Catalogos")" class="text-sm font-medium text-slate-500 hover:text-indigo-600 flex items-center gap-1 transition-colors">
            &larr; Volver al Panel de Catálogos
        </a>
    </div>

    <div class="mb-8 border-b border-slate-200 pb-5">
        <h1 class="text-2xl font-bold tracking-tight text-slate-950">Catálogo de Marcas</h1>
        <p class="text-sm text-slate-600 mt-1">Administración y control global de fabricantes asociados al equipamiento técnico.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 h-fit shadow-sm">
            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">
                Registrar Nueva Marca
            </h2>

            <form asp-action="CreateMarca" asp-controller="Catalogos" method="post" class="space-y-4">
                <div>
                    <label for="NombreMarca" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                        Nombre de la Marca
                    </label>
                    <input type="text" id="NombreMarca" name="NombreMarca" placeholder="Ej. Lenovo, Dell, Apple" required
                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all" />
                </div>

                <button type="submit" class="w-full flex justify-center items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">
                    Guardar Registro
                </button>
            </form>
        </div>

        <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50">
                            @* <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 w-24">ID</th> *@
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Nombre de la Marca</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right w-32">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="px-6 py-10 text-sm text-center text-slate-400 italic">
                                    No hay marcas registradas en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var marca in Model)
                            {
                                <tr id="fila-marca-@marca.IdMarca" class="hover:bg-slate-50/60 transition-colors">
                                    @* <td class="px-6 py-4 text-sm font-mono text-slate-400">#@marca.IdMarca</td> *@
                                    <td class="px-6 py-4 text-sm font-semibold text-slate-900" id="nombre-marca-@marca.IdMarca">@marca.NombreMarca</td>
                                    <td class="px-6 py-4 text-sm text-right space-x-1">
                                        <button onclick="editarMarca(@marca.IdMarca, '@marca.NombreMarca')" class="inline-flex items-center rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 transition-colors">
                                            Editar
                                        </button>
                                        <button onclick="eliminarRegistro(@marca.IdMarca)" class="inline-flex items-center rounded-lg px-2.5 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 hover:text-red-700 transition-colors">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function editarMarca(id, nombreActual) {
            if (typeof Swal === 'undefined') {
                const nuevo = prompt("Nombre de la marca:", nombreActual);
                if (nuevo && nuevo.trim()) {
                    enviarEdicionMarca(id, nuevo.trim());
                }
                return;
            }

            const { value: nuevoNombre } = await Swal.fire({
                title: 'Editar Marca',
                input: 'text',
                inputValue: nombreActual,
                inputLabel: 'Nombre del Fabricante / Marca',
                showCancelButton: true,
                confirmButtonText: 'Guardar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#4f46e5',
                customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl px-5 py-2.5', cancelButton: 'rounded-xl px-5 py-2.5' },
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'El nombre de la marca no puede estar vacío';
                    }
                }
            });

            if (nuevoNombre && nuevoNombre.trim() !== nombreActual) {
                enviarEdicionMarca(id, nuevoNombre.trim());
            }
        }

        function enviarEdicionMarca(id, nombre) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Catalogos/EditMarca';
            
            const inputId = document.createElement('input');
            inputId.type = 'hidden';
            inputId.name = 'IdMarca';
            inputId.value = id;
            
            const inputNom = document.createElement('input');
            inputNom.type = 'hidden';
            inputNom.name = 'NombreMarca';
            inputNom.value = nombre;
            
            form.appendChild(inputId);
            form.appendChild(inputNom);
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}