@model List<ObjetosIngresos.Models.CentrosFormacion>
@{
    ViewData["Title"] = "Administración de Centros de Formación";
    var regionales = ViewBag.Regionales as List<ObjetosIngresos.Models.Regionale>;
}

<div class="container mx-auto px-6 py-8">
    <div class="mb-4">
        <a href="@Url.Action("Index", "Catalogos")" class="text-sm font-medium text-slate-500 hover:text-indigo-600 flex items-center gap-1 transition-colors">
            &larr; Volver al Panel de Catálogos
        </a>
    </div>

    <div class="mb-8 border-b border-slate-200 pb-5">
        <h1 class="text-2xl font-bold tracking-tight text-slate-950">Catálogo de Centros de Formación</h1>
        <p class="text-sm text-slate-600 mt-1">Gestión de complejos educativos y su correspondiente delimitación territorial dentro del sistema.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 h-fit shadow-sm">
            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">
                Registrar Centro
            </h2>

            <form asp-action="CreateCentroFormacion" asp-controller="Catalogos" method="post" class="space-y-4">
                <div>
                    <label for="NombreCentro" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                        Nombre del Centro de Formación
                    </label>
                    <input type="text" id="NombreCentro" name="NombreCentro" placeholder="Ej. Centro de Operación y Desarrollo" required
                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all" />
                </div>

                <div>
                    <label for="IdRegional" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                        Regional Asociada
                    </label>
                    <select id="IdRegional" name="IdRegional" required
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all">
                        <option value="" disabled selected>Seleccione una regional</option>
                        @if (regionales != null)
                        {
                            foreach (var regional in regionales)
                            {
                                <option value="@regional.IdRegional">@regional.NombreRegional</option>
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="w-full flex justify-center items-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">
                    Guardar Centro
                </button>
            </form>
        </div>

        <div class="lg:col-span-2 bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50">
                            @* <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 w-24">ID</th> *@
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Centro de Formación</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500">Regional</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 text-right w-36">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="px-6 py-10 text-sm text-center text-slate-400 italic">
                                    No hay centros de formación registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var centro in Model)
                            {
                                <tr id="fila-centro-@centro.IdCentro" class="hover:bg-slate-50/60 transition-colors">
                                    <td class="px-6 py-4 text-sm font-semibold text-slate-900">@centro.NombreCentro</td>
                                    <td class="px-6 py-4 text-sm font-medium text-indigo-600">
                                        @(centro.IdRegionalNavigation?.NombreRegional ?? "No asignada")
                                    </td>
                                    <td class="px-6 py-4 text-sm text-right space-x-1">
                                        <button onclick="editarCentro(@centro.IdCentro, '@centro.NombreCentro', @centro.IdRegional)" class="inline-flex items-center rounded-lg px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 transition-colors">
                                            Editar
                                        </button>
                                        <button onclick="eliminarCentroFormacion(@centro.IdCentro)" class="inline-flex items-center rounded-lg px-2.5 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 hover:text-red-700 transition-colors">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const listaRegionales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            regionales?.Select(r => new { id = r.IdRegional, nombre = r.NombreRegional }) ?? Enumerable.Empty<object>()
        ));

        async function editarCentro(id, nombreActual, regionalActualId) {
            let opcionesHtml = '';
            listaRegionales.forEach(r => {
                const selected = r.id === regionalActualId ? 'selected' : '';
                opcionesHtml += `<option value="${r.id}" ${selected}>${r.nombre}</option>`;
            });

            const htmlForm = `
                <div class="text-left space-y-3 mt-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Nombre del Centro</label>
                        <input id="swal-nombre-centro" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" value="${nombreActual}">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Regional</label>
                        <select id="swal-regional-centro" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
                            ${opcionesHtml}
                        </select>
                    </div>
                </div>
            `;

            const { value: formValues } = await Swal.fire({
                title: 'Editar Centro de Formación',
                html: htmlForm,
                showCancelButton: true,
                confirmButtonText: 'Guardar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#4f46e5',
                customClass: { popup: 'rounded-2xl', confirmButton: 'rounded-xl px-5 py-2.5', cancelButton: 'rounded-xl px-5 py-2.5' },
                preConfirm: () => {
                    const nombre = document.getElementById('swal-nombre-centro').value;
                    const idReg = document.getElementById('swal-regional-centro').value;
                    if (!nombre || !nombre.trim()) {
                        Swal.showValidationMessage('El nombre del centro es requerido');
                        return false;
                    }
                    if (!idReg) {
                        Swal.showValidationMessage('Debe seleccionar una regional');
                        return false;
                    }
                    return { nombre: nombre.trim(), idRegional: idReg };
                }
            });

            if (formValues) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Catalogos/EditCentroFormacion';

                const inId = document.createElement('input');
                inId.type = 'hidden';
                inId.name = 'IdCentro';
                inId.value = id;

                const inNom = document.createElement('input');
                inNom.type = 'hidden';
                inNom.name = 'NombreCentro';
                inNom.value = formValues.nombre;

                const inReg = document.createElement('input');
                inReg.type = 'hidden';
                inReg.name = 'IdRegional';
                inReg.value = formValues.idRegional;

                form.appendChild(inId);
                form.appendChild(inNom);
                form.appendChild(inReg);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
